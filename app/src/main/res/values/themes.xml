<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CallShift" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_accent</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:navigationBarColor">@color/brand_primary</item>
        <item name="android:windowBackground">@color/brand_primary</item>
    </style>

    <!-- Тема экрана звонка: без action bar, тёмный фон, показ поверх блокировки -->
    <style name="Theme.CallShift.InCall" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/brand_primary</item>
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:navigationBarColor">@color/brand_primary</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <style name="Text.CallShift.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.CallShift.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.CallShift.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="Widget.CallShift.CallAction" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>

    <style name="Widget.CallShift.CallBig" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.CallShift.DtmfKey" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">76dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">#5A7A6B</item>
    </style>

    <style name="Widget.CallShift.DialKey" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">68dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>

    <!-- ===== Экран звонка ===== -->
    <!-- Круглая кнопка управления (микрофон/динамик/…) 64dp -->
    <style name="Widget.CallShift.RoundControl">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:background">@drawable/bg_circle</item>
        <item name="android:backgroundTint">#26FFFFFF</item>
        <item name="android:scaleType">center</item>
        <item name="android:padding">18dp</item>
        <item name="tint">#FFFFFF</item>
    </style>

    <!-- Большая круглая кнопка вызова/сброса 76dp -->
    <style name="Widget.CallShift.RoundCall">
        <item name="android:layout_width">76dp</item>
        <item name="android:layout_height">76dp</item>
        <item name="android:background">@drawable/bg_circle</item>
        <item name="android:scaleType">center</item>
        <item name="android:padding">20dp</item>
        <item name="android:elevation">6dp</item>
        <item name="tint">#FFFFFF</item>
    </style>

    <!-- Подпись под круглой кнопкой -->
    <style name="Text.CallShift.ControlLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">#D8E7DE</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Круглая клавиша цифровой клавиатуры (цифра + буквы задаются в коде) -->
    <style name="Widget.CallShift.RoundKey">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:background">@drawable/bg_circle</item>
        <item name="android:backgroundTint">#1FFFFFFF</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">28sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:lineSpacingMultiplier">0.85</item>
    </style>
</resources>
