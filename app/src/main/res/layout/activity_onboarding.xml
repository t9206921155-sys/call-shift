<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_primary"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="Мастер настройки CallShift"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Для работы перехвата и переадресации звонков приложению необходимы системные роли и разрешения."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Юридическое уведомление:"
            android:textColor="@color/brand_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_card"
            android:padding="12dp"
            android:text="CallShift предназначен для личного использования на ваших собственных SIM-картах. Экстренные вызовы (112, 911 и др.) никогда не блокируются."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/cbDisclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:text="Я прочитал(а) и принимаю условия"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Шаги активации перехвата:"
            android:textColor="@color/brand_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRequestPerms"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:enabled="false"
            android:text="1. Запросить разрешения (Телефон/Контакты)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRequestRole"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/brand_accent_dark"
            android:enabled="false"
            android:text="2. Назначить роль Call Screening"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            style="@style/Widget.CallShift.CallBig"
            android:layout_width="match_parent"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/status_ok"
            android:enabled="false"
            android:text="Начать работу" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
