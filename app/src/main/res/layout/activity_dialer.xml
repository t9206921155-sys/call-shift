<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_primary"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Заголовок / панель навигации -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_dialer"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRules"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Правила"
            android:textColor="@color/brand_accent" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Поле ввода номера -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/tvNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:hint="Введите номер"
            android:minHeight="56dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="30sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnBackspace"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Удалить"
            android:src="@android:drawable/ic_input_delete"
            app:tint="@color/text_secondary"
            android:visibility="invisible" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <!-- Цифровая клавиатура (4 строки LinearLayout для надёжного рендеринга на всех экранах) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Ряд 1: 1, 2, 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/k1"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="1"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                app:backgroundTint="@color/surface_card" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/k2"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:text="2"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                app:backgroundTint="@color/surface_card" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/k3"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="3"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                app:backgroundTint="@color/surface_card" />
        </LinearLayout>

        <!-- Ряд 2: 4, 5, 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/k4"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="4"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                app:backgroundTint="@color/surface_card" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/k5"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:text="5"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                app:backgroundTint="@color/surface_card" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/k6"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="6"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                app:backgroundTint="@color/surface_card" />
        </LinearLayout>

        <!-- Ряд 3: 7, 8, 9 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/k7"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="7"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                app:backgroundTint="@color/surface_card" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/k8"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:text="8"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                app:backgroundTint="@color/surface_card" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/k9"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="9"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                app:backgroundTint="@color/surface_card" />
        </LinearLayout>

        <!-- Ряд 4: *, 0, # -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/kStar"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="*"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                app:backgroundTint="@color/surface_card" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/k0"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                app:backgroundTint="@color/surface_card" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/kHash"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="#"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                app:backgroundTint="@color/surface_card" />
        </LinearLayout>
    </LinearLayout>

    <!-- Кнопка вызова -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCall"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/status_ok"
        android:text="Позвонить"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:cornerRadius="28dp" />

</LinearLayout>
