<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_primary"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Заголовок / панель навигации -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_dialer"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRules"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Правила"
            android:textColor="@color/brand_accent" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Поле ввода номера -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:hint="Введите номер"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="28sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnBackspace"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Удалить"
            android:src="@android:drawable/ic_input_delete"
            android:tint="@color/text_secondary"
            android:visibility="invisible" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <!-- Клавиатура набора номера -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3">

        <Button android:id="@+id/k1" style="@style/Widget.CallShift.DialKey" android:text="1" />
        <Button android:id="@+id/k2" style="@style/Widget.CallShift.DialKey" android:text="2" />
        <Button android:id="@+id/k3" style="@style/Widget.CallShift.DialKey" android:text="3" />

        <Button android:id="@+id/k4" style="@style/Widget.CallShift.DialKey" android:text="4" />
        <Button android:id="@+id/k5" style="@style/Widget.CallShift.DialKey" android:text="5" />
        <Button android:id="@+id/k6" style="@style/Widget.CallShift.DialKey" android:text="6" />

        <Button android:id="@+id/k7" style="@style/Widget.CallShift.DialKey" android:text="7" />
        <Button android:id="@+id/k8" style="@style/Widget.CallShift.DialKey" android:text="8" />
        <Button android:id="@+id/k9" style="@style/Widget.CallShift.DialKey" android:text="9" />

        <Button android:id="@+id/kStar" style="@style/Widget.CallShift.DialKey" android:text="*" />
        <Button android:id="@+id/k0" style="@style/Widget.CallShift.DialKey" android:text="0" />
        <Button android:id="@+id/kHash" style="@style/Widget.CallShift.DialKey" android:text="#" />
    </GridLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <!-- Кнопка вызова -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCall"
        style="@style/Widget.CallShift.CallBig"
        android:layout_width="match_parent"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/status_ok"
        android:text="Позвонить" />

</LinearLayout>
