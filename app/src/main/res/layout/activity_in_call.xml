<?xml version="1.0" encoding="utf-8"?>
<!-- Экран входящего/активного вызова (роль «Телефон»). Тёмный градиент, крупный аватар,
     круглые кнопки управления, быстрый SMS-ответ, клавиатура тонов. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_call_gradient"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <!-- Вызовы на удержании / второй линии -->
    <LinearLayout
        android:id="@+id/secondaryCalls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Чип с SIM-картой -->
    <TextView
        android:id="@+id/tvSimChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_chip"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:textColor="#D8E7DE"
        android:textSize="13sp"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_sim"
        app:drawableTint="#D8E7DE" />

    <!-- ===== Кто звонит ===== -->
    <LinearLayout
        android:id="@+id/callerBlock"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/avatarFrame"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_avatar">

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_person" />

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="44sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvCallName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/unknown"
            android:textColor="#FFFFFF"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/tvCallNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="#BFD6C9"
            android:textIsSelectable="true"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvCallState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:textColor="#7FE0AE"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvForwardHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ===== Клавиатура тонов (во время разговора) ===== -->
    <LinearLayout
        android:id="@+id/dtmfPad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvDtmfDigits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:ellipsize="start"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">
            <TextView android:id="@+id/d1" style="@style/Widget.CallShift.RoundKey" />
            <TextView android:id="@+id/d2" style="@style/Widget.CallShift.RoundKey" />
            <TextView android:id="@+id/d3" style="@style/Widget.CallShift.RoundKey" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">
            <TextView android:id="@+id/d4" style="@style/Widget.CallShift.RoundKey" />
            <TextView android:id="@+id/d5" style="@style/Widget.CallShift.RoundKey" />
            <TextView android:id="@+id/d6" style="@style/Widget.CallShift.RoundKey" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">
            <TextView android:id="@+id/d7" style="@style/Widget.CallShift.RoundKey" />
            <TextView android:id="@+id/d8" style="@style/Widget.CallShift.RoundKey" />
            <TextView android:id="@+id/d9" style="@style/Widget.CallShift.RoundKey" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">
            <TextView android:id="@+id/dStar" style="@style/Widget.CallShift.RoundKey" />
            <TextView android:id="@+id/d0" style="@style/Widget.CallShift.RoundKey" />
            <TextView android:id="@+id/dHash" style="@style/Widget.CallShift.RoundKey" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Кнопки управления разговором ===== -->
    <LinearLayout
        android:id="@+id/controlsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnMute"
                    style="@style/Widget.CallShift.RoundControl"
                    android:contentDescription="Без звука"
                    android:src="@drawable/ic_mic_off" />

                <TextView
                    android:id="@+id/lblMute"
                    style="@style/Text.CallShift.ControlLabel"
                    android:text="Без звука" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnKeypad"
                    style="@style/Widget.CallShift.RoundControl"
                    android:contentDescription="Клавиатура"
                    android:src="@drawable/ic_dialpad" />

                <TextView
                    android:id="@+id/lblKeypad"
                    style="@style/Text.CallShift.ControlLabel"
                    android:text="Клавиатура" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnSpeaker"
                    style="@style/Widget.CallShift.RoundControl"
                    android:contentDescription="Динамик"
                    android:src="@drawable/ic_volume_up" />

                <TextView
                    android:id="@+id/lblSpeaker"
                    style="@style/Text.CallShift.ControlLabel"
                    android:text="Динамик" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnHold"
                    style="@style/Widget.CallShift.RoundControl"
                    android:contentDescription="Удержать"
                    android:src="@drawable/ic_pause" />

                <TextView
                    android:id="@+id/lblHold"
                    style="@style/Text.CallShift.ControlLabel"
                    android:text="Удержать" />
            </LinearLayout>
    </LinearLayout>

    <!-- ===== Быстрые SMS-ответы (входящий) ===== -->
    <LinearLayout
        android:id="@+id/quickReplies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_sheet"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Отклонить и отправить SMS"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/quickRepliesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- ===== Нижний ряд: входящий ===== -->
    <LinearLayout
        android:id="@+id/incomingRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnReject"
                style="@style/Widget.CallShift.RoundCall"
                android:backgroundTint="#E53935"
                android:contentDescription="@string/incall_reject"
                android:src="@drawable/ic_call_end" />

            <TextView style="@style/Text.CallShift.ControlLabel" android:text="@string/incall_reject" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnSms"
                style="@style/Widget.CallShift.RoundControl"
                android:contentDescription="SMS"
                android:src="@drawable/ic_message" />

            <TextView style="@style/Text.CallShift.ControlLabel" android:text="SMS" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnAnswer"
                style="@style/Widget.CallShift.RoundCall"
                android:backgroundTint="#43A047"
                android:contentDescription="@string/incall_answer"
                android:src="@drawable/ic_call" />

            <TextView style="@style/Text.CallShift.ControlLabel" android:text="@string/incall_answer" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Нижний ряд: разговор ===== -->
    <LinearLayout
        android:id="@+id/activeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnHangup"
            style="@style/Widget.CallShift.RoundCall"
            android:backgroundTint="#E53935"
            android:contentDescription="@string/incall_hangup"
            android:src="@drawable/ic_call_end" />
    </LinearLayout>

</LinearLayout>
