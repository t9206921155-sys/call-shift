<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/brand_primary"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <TextView android:id="@+id/diagHeader" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp"
            android:textColor="#FFB74D" android:paddingBottom="6dp"/>
        <Button android:id="@+id/diagCopy" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Скопировать диагноз экрана"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Мессенджеры" android:textSize="22sp" android:textStyle="bold"
            android:textColor="@color/text_primary"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Статус, лимит и настройка каждого канала. Канал выбирается в правиле звонка."
            android:textSize="13sp" android:textColor="@color/text_secondary"
            android:paddingBottom="10dp"/>

        <TextView android:id="@+id/maxHeader" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="MAX" android:textSize="18sp"
            android:textStyle="bold" android:textColor="@color/text_primary" android:paddingTop="6dp"/>
        <TextView android:id="@+id/maxChip" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold"
            android:paddingTop="2dp"/>
        <TextView android:id="@+id/maxNext" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold"
            android:paddingTop="4dp"/>
        <TextView android:id="@+id/maxUsage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp"
            android:textColor="@color/text_secondary" android:paddingTop="2dp"/>
        <Button android:id="@+id/maxLimit" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
        <TextView android:id="@+id/maxToggle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Подробнее ▸"
            android:textSize="13sp" android:textStyle="bold" android:gravity="end"
            android:textColor="@color/brand_accent" android:paddingTop="4dp"/>
        <TextView android:id="@+id/maxDetails" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp"
            android:textColor="@color/text_secondary" android:visibility="gone"/>
        <Button android:id="@+id/maxOpen" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="Настройка MAX"/>

        <TextView android:id="@+id/tgHeader" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Telegram" android:textSize="18sp"
            android:textStyle="bold" android:textColor="@color/text_primary" android:paddingTop="10dp"/>
        <TextView android:id="@+id/tgChip" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold"
            android:paddingTop="2dp"/>
        <TextView android:id="@+id/tgNext" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold"
            android:paddingTop="4dp"/>
        <TextView android:id="@+id/tgUsage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp"
            android:textColor="@color/text_secondary" android:paddingTop="2dp"/>
        <Button android:id="@+id/tgLimit" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
        <TextView android:id="@+id/tgToggle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Подробнее ▸"
            android:textSize="13sp" android:textStyle="bold" android:gravity="end"
            android:textColor="@color/brand_accent" android:paddingTop="4dp"/>
        <TextView android:id="@+id/tgDetails" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp"
            android:textColor="@color/text_secondary" android:visibility="gone"/>
        <Button android:id="@+id/tgOpen" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="Аккаунт Telegram и имитация"/>

        <TextView android:id="@+id/smsHeader" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="SMS" android:textSize="18sp"
            android:textStyle="bold" android:textColor="@color/text_primary" android:paddingTop="10dp"/>
        <TextView android:id="@+id/smsChip" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold"
            android:paddingTop="2dp"/>
        <TextView android:id="@+id/smsNext" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold"
            android:paddingTop="4dp"/>
        <TextView android:id="@+id/smsUsage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp"
            android:textColor="@color/text_secondary" android:paddingTop="2dp"/>
        <Button android:id="@+id/smsLimit" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
        <TextView android:id="@+id/smsToggle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Подробнее ▸"
            android:textSize="13sp" android:textStyle="bold" android:gravity="end"
            android:textColor="@color/brand_accent" android:paddingTop="4dp"/>
        <TextView android:id="@+id/smsDetails" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp"
            android:textColor="@color/text_secondary" android:visibility="gone"/>
        <Button android:id="@+id/smsRules" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="Правила SMS"/>
        <Button android:id="@+id/smsSafety" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="Защита, расходы и копия"/>

        <TextView android:id="@+id/faultText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp"
            android:textColor="@color/status_error" android:paddingTop="8dp"
            android:visibility="gone"/>
        <TextView android:id="@+id/footerVersion" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="12sp"
            android:textColor="@color/text_muted" android:paddingTop="12dp"/>
    </LinearLayout>
</ScrollView>
